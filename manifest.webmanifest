{
  "name": "Pixel Arcade",
  "short_name": "Pixel Arcade",
  "description": "502 original browser games, 47 full-3D worlds and a 2D/3D game builder. Free, open source, works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["games", "entertainment", "education"],
  "icons": [
    {"src": "docs/icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "docs/icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "docs/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Game Builder", "url": "builder/", "icons": [{"src": "docs/icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Voxel Frontier", "url": "voxel/"},
    {"name": "Orbit Lab", "url": "orbit/"}
  ]
}
